# Postgres (local dev: user-owned instance on 5433, see README)
DATABASE_URL=postgres://sdr@127.0.0.1:5433/sdr_cadence

# Anthropic API key (research + drafting)
ANTHROPIC_API_KEY=

# Collateral Librarian MCP endpoint INCLUDING its key segment (secret)
LIBRARIAN_MCP_URL=https://data-room.faclon.com/mcp/<scope>/k/<key>

# Google OAuth client (Workspace "Internal" app). Redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3000
# Restrict sign-in to this Workspace domain, e.g. faclon.com
ALLOWED_EMAIL_DOMAIN=

# 32+ char random string for the session cookie
SESSION_SECRET=
# 64 hex chars (openssl rand -hex 32) used to encrypt Google refresh tokens
TOKEN_ENCRYPTION_KEY=

# draft_only = create Gmail drafts but never send. Switch to live when ready.
SEND_MODE=draft_only

# Model overrides (defaults shown)
MODEL_RESEARCH=claude-sonnet-5
MODEL_DRAFT=claude-sonnet-5
MODEL_CLASSIFY=claude-haiku-4-5
